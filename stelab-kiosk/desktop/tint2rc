# STELAB taskbar: no compositor, graphs, monitors or periodic shell commands.
# Background 1: panel
rounded = 8
border_width = 1
background_color = #0c1926 100
border_color = #344653 100
# Background 2: inactive/minimized tasks
rounded = 6
border_width = 0
background_color = #182a38 100
# Background 3: active task
rounded = 6
border_width = 1
background_color = #58412b 100
border_color = #ffb563 100
panel_items = LTC
panel_size = 100% 46
panel_position = bottom center horizontal
panel_monitor = primary
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_layer = top
panel_dock = 0
panel_window_name = STELAB Taskbar
wm_menu = 0
disable_transparency = 1
font_shadow = 0
autohide = 1
autohide_show_timeout = 0.1
autohide_hide_timeout = 1.2
autohide_height = 4
strut_policy = minimum
launcher_padding = 0 0 5
launcher_background_id = 0
launcher_icon_size = 28
launcher_item_app = ~/.local/share/applications/stelab-dashboard.desktop
launcher_item_app = ~/.local/share/applications/stelab-chatgpt.desktop
launcher_item_app = ~/.local/share/applications/stelab-web.desktop
taskbar_mode = single_desktop
taskbar_padding = 4 0 4
taskbar_background_id = 0
taskbar_hide_inactive_tasks = 0
taskbar_hide_different_monitor = 0
taskbar_sort_order = none
taskbar_name = 0
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 210 36
task_padding = 8 3 6
task_font = DejaVu Sans 11
task_font_color = #dbe6ee 100
task_active_font_color = #ffbc79 100
task_iconified_font_color = #91a3b0 100
task_background_id = 2
task_active_background_id = 3
task_iconified_background_id = 2
task_tooltip = 1
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none
time1_format = %H:%M
time1_font = DejaVu Sans Bold 12
clock_font_color = #e6edf2 100
clock_padding = 8 0
clock_tooltip = %A %d. %m. %Y
